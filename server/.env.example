# Cadena de conexión de MongoDB Atlas (Database → Connect → Drivers)
# Reemplaza <usuario> y <password>. Si la contraseña tiene caracteres especiales (@ : / ? #), codifícalos (ej: @ → %40)
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=portfolio
MONGODB_DB=portfolio

PORT=4000
# Orígenes permitidos (separados por coma)
CLIENT_URL=http://localhost:5173

# Panel de administración (los genera: npm run set-password -- TuClave)
ADMIN_PASSWORD_HASH=
JWT_SECRET=
